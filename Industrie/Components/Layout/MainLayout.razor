@using Radzen.Blazor
@using System.Timers
@implements IDisposable
@inherits LayoutComponentBase

<RadzenComponents />

<RadzenLayout Style="grid-template-areas: 'rz-header rz-header' 'rz-sidebar rz-body'; grid-template-columns: auto 1fr; grid-template-rows: auto 1fr; height: 100vh;">

    <RadzenHeader Class="custom-pharma-header" Style="height: 70px; z-index: 2; background-color: #1967be; grid-area: rz-header;">
        <div class="header-content-wrapper">

            <div class="header-left">
                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat" Class="text-white" Style="background: transparent;" />
            </div>

            <div class="header-center">
                <div class="logo-parallelogram bg-white">
                    <div class="logo-container">
                        <img src="images/Logo.png" alt="Médis / Neapolis" />
                    </div>
                </div>
            </div>



            <div class="header-right text-white text-end">
                <div class="date-time-container">
                    <div class="fw-bold text-capitalize text-sm leading-none">@tunisDateTime.ToString("dddd dd MMM.", new System.Globalization.CultureInfo("fr-FR"))</div>
                    <div class="text-xs opacity-75 mt-1">@tunisDateTime.ToString("HH:mm")</div>
                </div>

                <div class="profile-avatar-wrapper">
                    <RadzenIcon Icon="person" Style="font-size: 1.5rem; color: white;" />
                </div>
            </div>

        </div>
    </RadzenHeader>


    <RadzenSidebar @bind-Expanded="@sidebarExpanded" Class="bg-light border-end p-0" Style="grid-area: rz-sidebar; width: 260px;">
        <NavMenu />
    </RadzenSidebar>



    <RadzenBody Style="grid-area: rz-body;" Class="bg-body-tertiary p-4 overflow-auto">
        <RadzenCard Variant="Variant.Flat" Class="rz-border-radius-8 rz-shadow-xs min-vh-100 p-4 bg-white">
            @Body
        </RadzenCard>
    </RadzenBody>

</RadzenLayout>

@code {
    private bool sidebarExpanded = true;
    private DateTime tunisDateTime;
    private Timer? timer;

    protected override void OnInitialized()
    {
        UpdateTunisTime();

        timer = new Timer(60000);
        timer.Elapsed += OnTimerElapsed;
        timer.AutoReset = true;
        timer.Start();
    }

    private void OnTimerElapsed(object? sender, ElapsedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            UpdateTunisTime();
            StateHasChanged();
        });
    }

    private void UpdateTunisTime()
    {
        tunisDateTime = DateTime.UtcNow.AddHours(1); // Heure de Tunis (UTC+1)
    }

    public void Dispose()
    {
        if (timer != null)
        {
            timer.Stop();
            timer.Elapsed -= OnTimerElapsed;
            timer.Dispose();
            timer = null;
        }
    }
}