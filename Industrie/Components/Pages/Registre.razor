@page "/machines"

@using Industrie.Models
@using Industrie.Services
@inject IMachineService MachineService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "Responsable")]

<PageTitle>Registre des Machines</PageTitle>

<!-- EN-TÊTE DE PAGE -->
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h3 class="m-0 text-primary fw-bold d-flex align-items-center">
            <RadzenIcon Icon="precision_manufacturing" Class="me-2 text-primary" />Registre des Machines
        </h3>
        <span class="text-muted small">Inventaire et suivi de conformité opérationnelle en temps réel</span>
    </div>
    <div class="d-flex gap-2">
        <RadzenButton Icon="refresh" Text="Actualiser" ButtonStyle="ButtonStyle.Light" Click="@LoadDataAsync" IsBusy="@isLoading" Class="shadow-sm" />
        <RadzenButton Icon="add_circle" Text="Nouvelle Machine" ButtonStyle="ButtonStyle.Primary" Click="@(() => NavigationManager.NavigateTo("/machines/form"))" Class="shadow-sm" />
    </div>
</div>

<!-- BARRE DE FILTRES RESPONSIVE -->
<RadzenCard Class="rz-shadow-sm mb-4 p-3 bg-white">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="fw-bold text-dark d-flex align-items-center small text-uppercase">
            <RadzenIcon Icon="filter_alt" Class="me-1 text-primary" />Filtres de recherche avancés
        </span>
        <RadzenButton Icon="restart_alt" Text="Réinitialiser" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@ResetFilters" />
    </div>

    <div class="row g-2 align-items-center">
        <!-- RECHERCHE GLOBALE -->
        <div class="col-lg-3 col-md-6 col-12">
            <RadzenFormField Text="Recherche globale" Style="width: 100%;">
                <RadzenTextBox Value="@searchTerm"
                               @oninput="@(args => { searchTerm = args.Value?.ToString() ?? string.Empty; })"
                               Placeholder="Code, nom, PC, IP..."
                               Style="width: 100%;" />
            </RadzenFormField>
        </div>

        <!-- SITE -->
        <div class="col-lg-2 col-md-3 col-6">
            <RadzenFormField Text="Site / Emplacement" Style="width: 100%;">
                <RadzenDropDown Data="@sitesList"
                                TextProperty="Name"
                                ValueProperty="Id"
                                @bind-Value="@selectedSiteId"
                                AllowClear="true"
                                Placeholder="Tous"
                                Style="width: 100%;" />
            </RadzenFormField>
        </div>

        <!-- OS -->
        <div class="col-lg-2 col-md-3 col-6">
            <RadzenFormField Text="Système (OS)" Style="width: 100%;">
                <RadzenDropDown Data="@osList"
                                TextProperty="Name"
                                ValueProperty="Id"
                                @bind-Value="@selectedOSId"
                                AllowClear="true"
                                Placeholder="Tous"
                                Style="width: 100%;" />
            </RadzenFormField>
        </div>

        <!-- ECRAN -->
        <div class="col-lg-2 col-md-6 col-6">
            <RadzenFormField Text="Type d'Écran" Style="width: 100%;">
                <RadzenDropDown Data="@ecransList"
                                TextProperty="Name"
                                ValueProperty="Id"
                                @bind-Value="@selectedEcranId"
                                AllowClear="true"
                                Placeholder="Tous"
                                Style="width: 100%;" />
            </RadzenFormField>
        </div>

        <!-- BACKUP -->
        <div class="col-lg-3 col-md-6 col-6">
            <RadzenFormField Text="Statut Sauvegarde" Style="width: 100%;">
                <RadzenDropDown Data="@backupOptions"
                                TextProperty="Text"
                                ValueProperty="Value"
                                @bind-Value="@selectedBackupFilter"
                                AllowClear="true"
                                Placeholder="Tous les statuts"
                                Style="width: 100%;" />
            </RadzenFormField>
        </div>
    </div>
</RadzenCard>

<!-- TABLEAU DU REGISTRE -->
<RadzenCard Class="rz-shadow-sm p-3">
    <div class="mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
            Inventaire : <strong>@FilteredMachines.Count()</strong> machine(s) filtrée(s) sur un total de <strong>@machinesList.Count</strong>
        </span>
    </div>

    <RadzenDataGrid Data="@FilteredMachines"
                    TItem="Machine"
                    AllowSorting="true"
                    AllowPaging="true"
                    PageSize="10"
                    PagerHorizontalAlign="HorizontalAlign.Left"
                    ShowPagingSummary="true"
                    IsLoading="@isLoading"
                    Class="rz-data-grid">
        <Columns>

            <!-- CODE -->
            <RadzenDataGridColumn Property="Code" Title="Code" Width="120px">
                <Template Context="m">
                    <RadzenBadge BadgeStyle="BadgeStyle.Dark" Text="@m.Code" Class="w-100 text-center shadow-xs" />
                </Template>
            </RadzenDataGridColumn>

            <!-- DESIGNATION & PC NAME -->
            <RadzenDataGridColumn Property="Name" Title="Désignation & PC" Width="200px">
                <Template Context="m">
                    <div class="d-flex flex-column">
                        <strong class="text-primary">@m.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(m.PcName))
                        {
                            <small class="text-muted"><RadzenIcon Icon="desktop_windows" Style="font-size: 11px;" Class="me-1" />@m.PcName</small>
                        }
                    </div>
                </Template>
            </RadzenDataGridColumn>

            <!-- SITE -->
            <RadzenDataGridColumn Property="Site.Name" Title="Site" Width="140px">
                <Template Context="m">
                    <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="@(m.Site?.Name ?? "Non défini")" IsPill="true" />
                </Template>
            </RadzenDataGridColumn>

            <!-- OS -->
            <RadzenDataGridColumn Property="TypeOS.Name" Title="OS" Width="140px">
                <Template Context="m">
                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@(m.TypeOS?.Name ?? "Non défini")" IsPill="true" />
                </Template>
            </RadzenDataGridColumn>

            <!-- ECRAN -->
            <RadzenDataGridColumn Property="TypeEcran.Name" Title="Écran" Width="150px">
                <Template Context="m">
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="@(m.TypeEcran?.Name ?? "Non défini")" IsPill="true" />
                </Template>
            </RadzenDataGridColumn>

            <!-- SESSION & MDP (AVEC CHIFFREMENT AES-GCM & COPIE) -->
            <RadzenDataGridColumn Property="Session" Title="Session & Mdp" Width="220px" Sortable="false">
                <Template Context="m">
                    <div>
                        <small class="d-block text-muted">Compte : <strong>@(string.IsNullOrWhiteSpace(m.Session) ? "-" : m.Session)</strong></small>
                        <div class="d-flex align-items-center gap-1 mt-1">
                            @if (IsPasswordVisible(m.Code))
                            {
                                @if (m.Mdp.StartsWith("[Erreur"))
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@m.Mdp" />
                                }
                                else
                                {
                                    <span class="password-box text-truncate" style="max-width: 120px;" title="@m.Mdp">
                                        @m.Mdp
                                    </span>
                                    <RadzenButton Icon="content_copy"
                                                  Size="ButtonSize.ExtraSmall"
                                                  ButtonStyle="ButtonStyle.Light"
                                                  Click="@(() => CopyToClipboard(m.Mdp))"
                                                  ToolTip="Copier le mot de passe" />
                                }
                            }
                            else
                            {
                                <span class="password-box text-muted">••••••••</span>
                            }

                            <RadzenButton Icon="@(IsPasswordVisible(m.Code) ? "visibility_off" : "visibility")"
                                          Size="ButtonSize.ExtraSmall"
                                          ButtonStyle="@(IsPasswordVisible(m.Code) ? ButtonStyle.Warning : ButtonStyle.Light)"
                                          Click="@(() => TogglePasswordVisibility(m.Code))"
                                          ToolTip="@(IsPasswordVisible(m.Code) ? "Masquer" : "Afficher")" />
                        </div>
                    </div>
                </Template>
            </RadzenDataGridColumn>

            <!-- ADRESSES IP -->
            <RadzenDataGridColumn Property="AdresseIpInterne" Title="Réseau IP" Width="160px">
                <Template Context="m">
                    <small class="d-block"><strong>Int :</strong> @(string.IsNullOrWhiteSpace(m.AdresseIpInterne) ? "-" : m.AdresseIpInterne)</small>
                    <small class="d-block text-muted"><strong>Ext :</strong> @(string.IsNullOrWhiteSpace(m.AdresseIpExterne) ? "-" : m.AdresseIpExterne)</small>
                </Template>
            </RadzenDataGridColumn>

            <!-- BACKUP -->
            <RadzenDataGridColumn Property="Bukup" Title="Backup" Width="130px" TextAlign="TextAlign.Center">
                <Template Context="m">
                    @if (m.Bukup)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Actif" IsPill="true" />
                        <br />
                        <small class="text-muted font-monospace" style="font-size: 0.75rem;">
                            @m.DateBukup.ToString("dd/MM/yyyy")
                        </small>
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Inactif" IsPill="true" />
                    }
                </Template>
            </RadzenDataGridColumn>

            <!-- ACTIONS -->
            <RadzenDataGridColumn Title="Actions" Sortable="false" Width="110px" TextAlign="TextAlign.Center">
                <Template Context="m">
                    <RadzenButton Icon="edit"
                                  ButtonStyle="ButtonStyle.Warning"
                                  Size="ButtonSize.Small"
                                  Class="me-1"
                                  Click="@(() => NavigationManager.NavigateTo($"/machines/form/{m.Code}"))"
                                  ToolTip="Modifier" />
                    <RadzenButton Icon="delete"
                                  ButtonStyle="ButtonStyle.Danger"
                                  Size="ButtonSize.Small"
                                  Click="@(() => ConfirmDeleteAsync(m))"
                                  ToolTip="Supprimer" />
                </Template>
            </RadzenDataGridColumn>

        </Columns>
        <EmptyTemplate>
            <div class="text-center py-5 text-muted">
                <RadzenIcon Icon="search_off" Style="font-size: 2.5rem;" Class="mb-2 text-muted" />
                <h6>Aucune machine ne correspond aux critères sélectionnés.</h6>
                <RadzenButton Text="Réinitialiser les filtres" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@ResetFilters" Class="mt-2" />
            </div>
        </EmptyTemplate>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private List<Machine> machinesList = new();
    private List<Site> sitesList = new();
    private List<OS> osList = new();
    private List<Ecran> ecransList = new();

    private HashSet<string> visiblePasswords = new();
    private bool isLoading = false;

    // Filtres
    private string searchTerm = string.Empty;
    private int? selectedSiteId;
    private int? selectedOSId;
    private int? selectedEcranId;
    private bool? selectedBackupFilter;

    private readonly List<BackupOption> backupOptions = new()
    {
        new BackupOption { Text = "Sauvegardé (Actif)", Value = true },
        new BackupOption { Text = "Non sauvegardé (Inactif)", Value = false }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var sitesTask = MachineService.GetAllSitesAsync();
            var osTask = MachineService.GetAllOSAsync();
            var ecransTask = MachineService.GetAllEcransAsync();
            var machinesTask = MachineService.GetAllAsync();

            await Task.WhenAll(sitesTask, osTask, ecransTask, machinesTask);

            sitesList = await sitesTask;
            osList = await osTask;
            ecransList = await ecransTask;
            machinesList = await machinesTask;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur de chargement", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<Machine> FilteredMachines
    {
        get
        {
            var query = machinesList.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                query = query.Where(m =>
                    (m.Code?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.PcName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.AdresseIpInterne?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.AdresseIpExterne?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)
                );
            }

            if (selectedSiteId.HasValue && selectedSiteId.Value > 0)
            {
                query = query.Where(m => m.SiteId == selectedSiteId.Value);
            }

            if (selectedOSId.HasValue && selectedOSId.Value > 0)
            {
                query = query.Where(m => m.OSId == selectedOSId.Value);
            }

            if (selectedEcranId.HasValue && selectedEcranId.Value > 0)
            {
                query = query.Where(m => m.EcranId == selectedEcranId.Value);
            }

            if (selectedBackupFilter.HasValue)
            {
                query = query.Where(m => m.Bukup == selectedBackupFilter.Value);
            }

            return query;
        }
    }

    private void ResetFilters()
    {
        searchTerm = string.Empty;
        selectedSiteId = null;
        selectedOSId = null;
        selectedEcranId = null;
        selectedBackupFilter = null;
    }

    private void TogglePasswordVisibility(string code)
    {
        if (visiblePasswords.Contains(code))
            visiblePasswords.Remove(code);
        else
            visiblePasswords.Add(code);
    }

    private bool IsPasswordVisible(string code) => visiblePasswords.Contains(code);

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            NotificationService.Notify(NotificationSeverity.Success, "Presse-papier", "Mot de passe copié !");
        }
        catch (Exception)
        {
            NotificationService.Notify(NotificationSeverity.Info, "Information", "Sélectionnez le mot de passe manuellement.");
        }
    }

    private async Task ConfirmDeleteAsync(Machine machine)
    {
        var confirm = await DialogService.Confirm(
            $"Voulez-vous vraiment supprimer la machine '{machine.Code}' ({machine.Name}) ?",
            "Confirmation de suppression",
            new ConfirmOptions { OkButtonText = "Oui, Supprimer", CancelButtonText = "Annuler" }
        );

        if (confirm == true)
        {
            try
            {
                await MachineService.DeleteMachineAsync(machine.Code);
                NotificationService.Notify(NotificationSeverity.Success, "Suppression réussie", $"La machine {machine.Code} a été supprimée.");
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Erreur", ex.Message);
            }
        }
    }

    private class BackupOption
    {
        public required string Text { get; set; }
        public bool Value { get; set; }
    }
}